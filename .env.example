# ============================================================
# Configuração do projeto RAG-CDC (POC)
# Copie este arquivo para .env e preencha os valores.
# ============================================================

# --- OpenRouter (LLM gratuito, compatível com API OpenAI) ---
# Crie uma chave gratuita em: https://openrouter.ai/keys
# Nunca commite sua chave real no Git.
# Compatibilidade: se preencher apenas esta chave, ela será usada como Chave API 1.
OPENROUTER_API_KEY=

# Chaves numeradas para alternar pela interface web.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Modelo geral gratuito fixo para demonstração e avaliação comparativa.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MAX_TOKENS=1800

# Site/App para metadados do OpenRouter (opcional)
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=RAG-CDC-POC

# Temperatura igual para RAG e baseline, conforme o TCC
LLM_TEMPERATURE=0.0

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragcdc
POSTGRES_USER=ragcdc
POSTGRES_PASSWORD=ragcdc

# --- Embeddings locais (Sentence Transformers) ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Corpus CDC ---
# URL oficial do Planalto. O texto será salvo em Markdown e indexado no pgvector.
CDC_URL=https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm
CDC_LOCAL_PATH=data/cdc.md

# --- Jurisprudência complementar STJ ---
STJ_LOCAL_PATH=corpus/stj_sumulas_consumidor.md
HISTORY_LOCAL_PATH=corpus/historico_cdc.md
